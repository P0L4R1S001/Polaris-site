      "Polarsirkelen Luft",
      "Russiair",
      "SaQr Airlines",
      "SpéirAir",
      "Star Air",
      "StopOver",
      "SunCoast Airways",
      "Visdéerø",
      "Volga Air",
      "yanito932"
    ];

    const intro = document.querySelector("#intro");
    const skipIntro = document.querySelector("#skipIntro");

    function closeIntro() {
      if (!intro || intro.classList.contains("is-hidden")) return;
      intro.classList.add("is-hidden");
      document.body.classList.remove("intro-active");
    }

    skipIntro.addEventListener("click", closeIntro);

    // Keep the intro brief and automatically reveal the site.
    const introTimer = window.setTimeout(closeIntro, 3200);

    // Reduced-motion users skip the animated intro.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.clearTimeout(introTimer);
      closeIntro();
    }

    const airlineGrid = document.querySelector("#airlineGrid");
    const airlineSearch = document.querySelector("#airlineSearch");
    const emptyAirlines = document.querySelector("#emptyAirlines");

    function renderAirlines(searchText = "") {
      const query = searchText.trim().toLocaleLowerCase();
      const matches = airlines.filter((name) =>
        name.toLocaleLowerCase().includes(query)
      );

      airlineGrid.replaceChildren();

      matches.forEach((name) => {
        const isLeader = name === "Redwood Airlines";
        const card = document.createElement("article");
        card.className = isLeader ? "airline-card leader-card" : "airline-card";

        const top = document.createElement("div");
        top.className = "airline-top";

        const label = document.createElement("span");
        label.className = "airline-code";
        label.textContent = isLeader ? "Alliance leader" : "Alliance airline";

        const mark = document.createElement("span");
        mark.className = "airline-mark";
        mark.setAttribute("aria-hidden", "true");
        mark.textContent = "✦";

        const heading = document.createElement("h3");
        heading.textContent = name;

        const description = document.createElement("p");
        description.textContent = isLeader
          ? "Leader of the Polaris Alliance."
          : "Member airline of the Polaris Alliance.";

        top.append(label, mark);
        card.append(top, heading, description);
        airlineGrid.append(card);
      });

      emptyAirlines.style.display = matches.length ? "none" : "block";
    }

    airlineSearch.addEventListener("input", (event) => {
      renderAirlines(event.target.value);
    });

    const menuToggle = document.querySelector("#menuToggle");
    const navContent = document.querySelector("#navContent");

    menuToggle.addEventListener("click", () => {
      const open = navContent.classList.toggle("open");
      menuToggle.setAttribute("aria-expanded", String(open));
    });

    navContent.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        navContent.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
      });
    });

    document.querySelector("#airlineTotal").textContent = airlines.length;
    document.querySelector("#directoryTotal").textContent = airlines.length;
    document.querySelector("#year").textContent = new Date().getFullYear();

    renderAirlines();
  </script>
</body>
</html>
